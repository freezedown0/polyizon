// Generated by CMake (AppIcon.cmake) — do not edit directly.
// GLFW's Win32 backend looks up an icon resource named exactly "GLFW_ICON"
// for the window class icon (title bar, alt-tab, taskbar); it also becomes
// the .exe's default Explorer icon since it's the only icon resource.
GLFW_ICON ICON "@POLYIZON_ICON_PATH@"
