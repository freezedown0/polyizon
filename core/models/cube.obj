# cube.obj - unit cube for the Phase 15 shadow-mapping test scene.
# Centered at the local origin, spanning -0.5..0.5 on each axis. 24 vertices
# (4 per face) rather than 8 shared ones, so each face keeps its own flat
# normal instead of an averaged/seamed one.

# Front (+Z)
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# Back (-Z)
v  0.5 -0.5 -0.5
v -0.5 -0.5 -0.5
v -0.5  0.5 -0.5
v  0.5  0.5 -0.5

# Right (+X)
v  0.5 -0.5  0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v  0.5  0.5  0.5

# Left (-X)
v -0.5 -0.5 -0.5
v -0.5 -0.5  0.5
v -0.5  0.5  0.5
v -0.5  0.5 -0.5

# Top (+Y)
v -0.5  0.5  0.5
v  0.5  0.5  0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5

# Bottom (-Y)
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5 -0.5  0.5
v -0.5 -0.5  0.5

vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

f 1//1 2//1 3//1 4//1
f 5//2 6//2 7//2 8//2
f 9//3 10//3 11//3 12//3
f 13//4 14//4 15//4 16//4
f 17//5 18//5 19//5 20//5
f 21//6 22//6 23//6 24//6
